; =====================================================================
;  ROGUE MUSTER - Microbee Premium Plus hardware and constants.
;  Z80 3.375 MHz; 1MB RAM; 32K PCG RAM (16 banks of 128 glyphs).
;  6545 CRTC: 40 x 25 characters of 8 lines = 320 x 200 pixels
;  (the mode BPM's MODES.COM test proved on the Premium Plus).
;  VIBED BY BPM 2026
; =====================================================================
P_PIOA      EQU $00         ; joystick (active low), b7 fire
P_PIOAC     EQU $01
P_PIOB      EQU $02         ; b6 speaker
P_PIOBC     EQU $03
P_COLCTL    EQU $08         ; b6: F800 window = colour RAM
P_ROMLAT    EQU $0B         ; 1 during keyboard scans
P_CRTCA     EQU $0C         ; 6545 address / status (b5 vertical blanking)
P_CRTCD     EQU $0D
P_LV        EQU $1C         ; b7 premium graphics, b4 attribute RAM, b0-3 PCG bank
P_MEM       EQU $50

LV_SCREEN   EQU $80
LV_ATTR     EQU $90
COL_ON      EQU $40
PCGWIN      EQU $F800

BLK_GFX     EQU 7           ; glyphs (16K) and the two pictures

BLACK       EQU 0
RED         EQU 1
GREEN       EQU 2
BROWN       EQU 3
BLUE        EQU 4
MAGENTA     EQU 5
CYAN        EQU 6
GREY        EQU 7
DGREY       EQU 8
BRED        EQU 9
BGREEN      EQU 10
YELLOW      EQU 11
BBLUE       EQU 12
BMAGENTA    EQU 13
BCYAN       EQU 14
WHITE       EQU 15
