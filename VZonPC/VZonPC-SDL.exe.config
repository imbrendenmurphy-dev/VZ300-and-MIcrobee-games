<?xml version="1.0" encoding="utf-8"?>
<!-- For Mono: where SDL2 is on each system. (Modern .NET finds it by itself; see src/Sdl.cs.) -->
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup>
  <dllmap dll="SDL2" os="linux,freebsd" target="libSDL2-2.0.so.0"/>
  <dllmap dll="SDL2" os="osx" target="libSDL2-2.0.0.dylib"/>
</configuration>
